DEF TP5_GND TP 0 40 Y Y 1 F N
F0 "TP" 0 -480 50 H V C CNN
F1 "GND" 0 480 50 H V C CNN
DRAW
S -600 -300 600 300 0 1 10 f
X TP 1 -800 200 200 R 40 40 1 1 B
ENDDRAW
ENDDEF
